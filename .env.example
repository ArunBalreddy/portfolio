# Email delivery for the contact form, via https://resend.com (free tier available).
# 1. Sign up at resend.com and create an API key.
# 2. Copy this file to `.env.local` and paste your key below.
RESEND_API_KEY=

# Where contact form submissions are delivered. Defaults to the address in
# src/content/profile.ts if not set.
CONTACT_TO_EMAIL=arunkumar800a@gmail.com

# The "from" address Resend sends as. The default below works out of the box
# on Resend's free tier without verifying a custom domain. Once you verify
# your own domain in Resend, change this to something like
# "Arun Kumar <contact@yourdomain.com>".
CONTACT_FROM_EMAIL=onboarding@resend.dev
